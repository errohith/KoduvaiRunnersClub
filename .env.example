# ════════════════════════════════════════════════════════════════════════════
# Koduvai Runners — the single configuration contract.
# Copy to `.env` (never commit `.env`). Every value is validated at startup by
# src/config/env.ts; the app refuses to boot with an actionable error if a
# required value is missing or malformed.
#
# Restart/redeploy: ALL values here are read at process start. Changing any of
# them requires restarting the web process AND the worker. Values prefixed
# NEXT_PUBLIC_ (none are used) would additionally require a rebuild.
# Day-to-day content (fees, events, copy, templates) lives in the database and
# is edited in /admin — no restart needed.
# ════════════════════════════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME="Koduvai Runners"
APP_ENV=development                 # development | test | staging | production
APP_URL=http://localhost:3000       # public origin; used for links, CSRF origin checks, webhooks
APP_TIMEZONE=Asia/Kolkata           # IANA zone used to display all timestamps
PORT=3000
CORS_ALLOWED_ORIGINS=               # comma-separated extra origins allowed to call /api/v1 (blank = same-origin only)
LOG_LEVEL=info                      # debug | info | warn | error
CRON_SECRET=change-me-long-random   # bearer token for /api/v1/internal/cron (serverless alternative to the worker)

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# `schema=` keeps all tables inside a dedicated Postgres schema.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/koduvai?schema=koduvai
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/koduvai?schema=koduvai  # used by migrations (bypasses poolers)
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/koduvai?schema=koduvai_test  # integration tests only

# ── Authentication (built-in session auth; see docs/ARCHITECTURE.md) ────────
AUTH_SECRET=generate-with-openssl-rand-hex-32     # HMAC key for signed tokens (unsubscribe links etc.), min 32 chars
SESSION_TTL_HOURS=12
ADMIN_BOOTSTRAP_ENABLED=true        # seed creates the first Super Admin when no users exist; set false afterwards
ADMIN_BOOTSTRAP_EMAIL=admin@example.org
ADMIN_BOOTSTRAP_PASSWORD=           # min 12 chars; required when bootstrap is enabled

# ── Email ───────────────────────────────────────────────────────────────────
EMAIL_ENABLED=false                 # false = messages are recorded as SKIPPED, never sent
EMAIL_PROVIDER=log                  # log | resend | smtp   (log = print to worker console, dev only)
EMAIL_API_BASE_URL=https://api.resend.com   # resend-compatible HTTP API base
EMAIL_API_KEY=
EMAIL_SMTP_URL=                     # smtp(s)://user:pass@host:port — when EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=no-reply@example.org     # must be a verified sender/domain at your provider
EMAIL_FROM_NAME="Koduvai Runners"
EMAIL_REPLY_TO=
EMAIL_WEBHOOK_SECRET=               # optional: shared secret for /api/v1/webhooks/email delivery callbacks

# ── WhatsApp (WhatsApp Business Platform / Cloud API) ───────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=log               # log | meta-cloud
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=              # system-user permanent token
WHATSAPP_APP_SECRET=                # Meta app secret — verifies X-Hub-Signature-256 on webhooks
WHATSAPP_WEBHOOK_VERIFY_TOKEN=      # any random string; enter the same value in Meta's webhook setup
# Webhook URL to register with Meta: ${APP_URL}/api/v1/webhooks/whatsapp

# ── Payments (disabled by default) ──────────────────────────────────────────
PAYMENT_ENABLED=false
PAYMENT_PROVIDER=none               # none | razorpay | mock (mock is refused when APP_ENV=production)
PAYMENT_API_BASE_URL=https://api.razorpay.com
PAYMENT_API_KEY_ID=
PAYMENT_API_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=INR
# Webhook URL to register with the provider: ${APP_URL}/api/v1/webhooks/payments/<provider>
# Success/failure pages are derived from APP_URL: /payment/status?ref=...

# ── Storage (uploads) ───────────────────────────────────────────────────────
STORAGE_PROVIDER=local              # local | s3  (s3 = any S3-compatible store: AWS, R2, MinIO...)
STORAGE_LOCAL_DIR=./uploads
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=            # public URL prefix for s3 objects (CDN or bucket URL)
UPLOAD_MAX_MB=5

# ── Notifications & operations ──────────────────────────────────────────────
CLUB_ADMIN_EMAIL=                   # comma-separated; receives new-application/contact alerts
CLUB_ADMIN_WHATSAPP=                # comma-separated E.164 numbers, e.g. +919876543210
MEMBER_ANNOUNCEMENTS_ENABLED=true
NOTIFICATION_RETRY_LIMIT=5
NOTIFICATION_TIMEOUT_MS=10000
WORKER_POLL_INTERVAL_MS=5000

{
  "name": "koduvai-runners",
  "version": "1.0.0",
  "private": true,
  "description": "Koduvai Runners — running club website and management platform",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx src/worker/run.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "admin:create": "tsx scripts/create-admin.ts",
    "env:check": "tsx scripts/check-env.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "audit:deps": "npm audit --omit=dev",
    "docs:openapi": "tsx scripts/write-openapi.ts",
    "docs:postman": "tsx scripts/write-postman.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "libphonenumber-js": "^1.13.15",
    "next": "^15.5.28",
    "nodemailer": "^10.1.7",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "react-markdown": "^10.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "dotenv": "^18.0.8",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.31",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  }
}
